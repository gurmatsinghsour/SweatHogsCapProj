# SweatHogs Medical AI Prediction System - Git Ignore File
# Humber College Capstone Project

# Environment and Configuration Files
*.env
.env*
config.ini
settings.json

# Model Files (too large for Git, should be stored in Git LFS or cloud storage)
*.pkl
*.pkt
*.h5
*.pt
*.pth
*.onnx
*.joblib

# Data Files - Access Control Policy
# Raw data: Public demo datasets (tracked with Git LFS)
# Processed data: Private (requires team authorization)
*.xlsx
*.xls

# PRIVATE: Processed data and preprocessing methods (contact team for access)
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
notebooks/data_preprocessing/*
!notebooks/data_preprocessing/.gitkeep
!notebooks/data_preprocessing/README.md

# PUBLIC: Raw demo datasets (tracked with Git LFS)
# These are anonymized datasets safe for academic use
!data/raw/diabetic_data.csv
!data/raw/diagnosis_num_mapping.csv
!data/raw/medical_data.csv

# Generated PDF Reports (contains patient information)
*.pdf
reports/generated_pdfs/*
!reports/generated_pdfs/.gitkeep

# Python Cache and Virtual Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
my_env/
venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and Temporary Files
*.log
*.tmp
*.temp
training_log.log
logs/

# Distribution and Build Files
build/
dist/
*.egg-info/

# Flask Instance Folder
instance/

# Coverage Reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# pytest Cache
.pytest_cache/

# Machine Learning Experiment Tracking
mlruns/
.mlflow/
wandb/

